{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Beszel",
          "description": "Web UI",
          "useHost": true,
          "target": "http://beszel:8090",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "beszel": {
  "container_name": "big-bear-beszel",
  "image": "henrygd/beszel:0.19.0@sha256:fefb27166f5e1611ebf67f8697ea928a23f44efdb00af922e2ac3b5faa2efd5c",
  "restart": "unless-stopped",
  "volumes": [
    "big-bear-beszel_data:/beszel_data"
  ],
  "ports": [
    "8090:8090"
  ]
}
    }
  }
}
