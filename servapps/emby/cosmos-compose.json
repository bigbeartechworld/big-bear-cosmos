{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Emby",
          "description": "Web UI",
          "useHost": true,
          "target": "http://emby:8096",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "emby": {
  "image": "linuxserver/emby:4.10.2@sha256:f3827243e5e7a54086714f3fa8a46192b8c81e3da7262443c83eb69b2a5d329a",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID",
    "TZ": "$TZ"
  },
  "ports": [
    {
      "target": 8096,
      "published": 8096,
      "protocol": "tcp"
    },
    {
      "target": 8920,
      "published": 8920,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/emby/config",
      "target": "/config"
    },
    {
      "type": "bind",
      "source": "/DATA/AppData/emby/data/tvshows",
      "target": "/data/tvshows"
    },
    {
      "type": "bind",
      "source": "/DATA/AppData/emby/data/movies",
      "target": "/data/movies"
    },
    {
      "type": "bind",
      "source": "/opt/vc/lib",
      "target": "/opt/vc/lib"
    }
  ]
}
    }
  }
}
