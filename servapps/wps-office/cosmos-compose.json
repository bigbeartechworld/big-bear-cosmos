{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Wps-office",
          "description": "Web UI",
          "useHost": true,
          "target": "http://wps-office:3000",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "wps-office": {
  "image": "linuxserver/wps-office:11.1.0@sha256:60bed84aaf47ba56057b89e3069f3721f8cec9f8e5905ed839cbaf879ad35c54",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID",
    "TZ": "$TZ"
  },
  "ports": [
    {
      "target": 3000,
      "published": 3000,
      "protocol": "tcp"
    },
    {
      "target": 3001,
      "published": 3001,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/wps-office/config",
      "target": "/config"
    }
  ]
}
    }
  }
}
