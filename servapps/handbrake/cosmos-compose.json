{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Handbrake",
          "description": "Web UI",
          "useHost": true,
          "target": "http://handbrake:3000",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "handbrake": {
  "image": "linuxserver/handbrake:1.11.2@sha256:a80a03a272e76b8deeec071e5b0a3c582708da5603eee354ca2cb1e72b9e01b2",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID",
    "TZ": "$TZ"
  },
  "ports": [
    {
      "target": 3000,
      "published": 3000,
      "protocol": "tcp"
    },
    {
      "target": 3001,
      "published": 3001,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/handbrake/config",
      "target": "/config"
    }
  ]
}
    }
  }
}
