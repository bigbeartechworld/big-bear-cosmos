{
  "cosmos-installer": {
    "routes": [
        {
          "name": "KitchenOwl",
          "description": "Web UI",
          "useHost": true,
          "target": "http://kitchenowl:9287",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "kitchenowl": {
  "container_name": "big-bear-kitchenowl",
  "image": "tombursch/kitchenowl:v0.7.10@sha256:bd821a41b8cb27fd7fcf429acd1fc67e9f889485a2cd1193d68c2d804a8e1bef",
  "restart": "unless-stopped",
  "ports": [
    "9287:8080"
  ],
  "environment": [
    "JWT_SECRET_KEY=7c7884a9-f13a-4e01-a2f0-310add0acf60"
  ],
  "volumes": [
    "big-bear-kitchenowl_data:/data"
  ]
}
    }
  }
}
