{
  "cosmos-installer": {
    "routes": [
        {
          "name": "SolidPing",
          "description": "Web UI",
          "useHost": true,
          "target": "http://solidping:4000",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "solidping": {
  "image": "ghcr.io/fclairamb/solidping:0.37.0@sha256:b7905f7747e217c259f7442b14fcdb49b145b06dbe6791f9fc8dd4dde5e95428",
  "container_name": "big-bear-solidping",
  "restart": "unless-stopped",
  "user": "0:0",
  "cap_add": [
    "NET_RAW"
  ],
  "ports": [
    "4000:4000"
  ],
  "volumes": [
    "big-bear-solidping_data:/data"
  ],
  "healthcheck": {
    "test": [
      "CMD",
      "/app/solidping",
      "healthcheck"
    ],
    "interval": "30s",
    "timeout": "5s",
    "retries": 3,
    "start_period": "15s"
  }
}
    }
  }
}
