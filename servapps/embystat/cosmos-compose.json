{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Embystat",
          "description": "Web UI",
          "useHost": true,
          "target": "http://embystat:6555",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "embystat": {
  "image": "linuxserver/embystat:0.2.0@sha256:adc479353fc0b810c21935a8fe3c2d20d9f7027edc9574477d702ec2ad414754",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID",
    "TZ": "$TZ"
  },
  "ports": [
    {
      "target": 6555,
      "published": 6555,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/embystat/config",
      "target": "/config"
    }
  ]
}
    }
  }
}
