{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Budibase",
          "description": "Web UI",
          "useHost": true,
          "target": "http://budibase:8080",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "budibase": {
  "container_name": "big-bear-budibase",
  "image": "budibase/budibase:3.41.3@sha256:f05b90c2b8afc951feb99931bb4646d2c94af37d9c576ef3c4e01d4fdc296dc1",
  "restart": "unless-stopped",
  "volumes": [
    "big-bear-budibase_data:/data"
  ],
  "ports": [
    "8080:80"
  ]
}
    }
  }
}
