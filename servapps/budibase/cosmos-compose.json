{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Budibase",
          "description": "Web UI",
          "useHost": true,
          "target": "http://budibase:8080",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "budibase": {
  "container_name": "big-bear-budibase",
  "image": "budibase/budibase:v3.50.0@sha256:9a04a2b5ac2ecccf85c65adca08c507601788093dba417e5ecf383e0a2452e54",
  "restart": "unless-stopped",
  "volumes": [
    "big-bear-budibase_data:/data"
  ],
  "ports": [
    "8080:80"
  ]
}
    }
  }
}
