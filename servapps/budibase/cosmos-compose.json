{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Budibase",
          "description": "Web UI",
          "useHost": true,
          "target": "http://budibase:8080",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "budibase": {
  "container_name": "big-bear-budibase",
  "image": "budibase/budibase:v3.47.0@sha256:77a6ed96f5e32b997e33409564bd3239438fc276e536d0f5ef3084e65c0f45ce",
  "restart": "unless-stopped",
  "volumes": [
    "big-bear-budibase_data:/data"
  ],
  "ports": [
    "8080:80"
  ]
}
    }
  }
}
