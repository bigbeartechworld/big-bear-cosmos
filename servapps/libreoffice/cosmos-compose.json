{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Libreoffice",
          "description": "Web UI",
          "useHost": true,
          "target": "http://libreoffice:3000",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "libreoffice": {
  "image": "linuxserver/libreoffice:25.8.7@sha256:cf7f029fd003d6111afeb27be62fd6c869de79d417531d9e90a77ff647730b02",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID",
    "TZ": "$TZ"
  },
  "ports": [
    {
      "target": 3000,
      "published": 3000,
      "protocol": "tcp"
    },
    {
      "target": 3001,
      "published": 3001,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/libreoffice/config",
      "target": "/config"
    }
  ]
}
    }
  }
}
