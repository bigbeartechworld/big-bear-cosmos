{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Airsonic-advanced",
          "description": "Web UI",
          "useHost": true,
          "target": "http://airsonic-advanced:4040",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "airsonic-advanced": {
  "image": "linuxserver/airsonic-advanced:11.1.4@sha256:019466a7eb31df29e23d39dcc73d1aa775be4fadc9aed0c0aecf1a3e54e21c77",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID",
    "TZ": "$TZ",
    "CONTEXT_PATH": "",
    "JAVA_OPTS": ""
  },
  "ports": [
    {
      "target": 4040,
      "published": 4040,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/airsonic-advanced/config",
      "target": "/config"
    },
    {
      "type": "bind",
      "source": "/DATA/AppData/airsonic-advanced/music",
      "target": "/music"
    },
    {
      "type": "bind",
      "source": "/DATA/AppData/airsonic-advanced/playlists",
      "target": "/playlists"
    },
    {
      "type": "bind",
      "source": "/DATA/AppData/airsonic-advanced/podcasts",
      "target": "/podcasts"
    },
    {
      "type": "bind",
      "source": "/DATA/AppData/airsonic-advanced/media",
      "target": "/media"
    }
  ]
}
    }
  }
}
