{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Feed2toot",
          "description": "Web UI",
          "useHost": true,
          "target": "http://feed2toot:8080",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "feed2toot": {
  "image": "linuxserver/feed2toot:0.17.20251115@sha256:59e3ea300189052aba25c527a3501ade5c3a57466761c8a1e0ab1c8bdf90170d",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID",
    "TZ": "$TZ",
    "FEED_LIMIT": ""
  },
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/feed2toot/config",
      "target": "/config"
    }
  ]
}
    }
  }
}
