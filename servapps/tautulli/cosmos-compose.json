{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Tautulli",
          "description": "Web UI",
          "useHost": true,
          "target": "http://tautulli:8181",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "tautulli": {
  "image": "linuxserver/tautulli:2.18.2@sha256:d3c53deb09f6b8fffd1476c7154da538394193955d1e909f3b126068102fb7cf",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID",
    "TZ": "$TZ"
  },
  "ports": [
    {
      "target": 8181,
      "published": 8181,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/tautulli/config",
      "target": "/config"
    }
  ]
}
    }
  }
}
