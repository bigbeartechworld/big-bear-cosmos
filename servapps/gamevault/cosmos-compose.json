{
  "cosmos-installer": {
    "routes": [
        {
          "name": "GameVault",
          "description": "Web UI",
          "useHost": true,
          "target": "http://gamevault:8080",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "gamevault": {
  "image": "phalcode/gamevault-backend:17.1.0@sha256:87999b98d686b3297ddd7abde51f42dd2fa30b987f0cf050a42403a398711199",
  "container_name": "gamevault",
  "restart": "unless-stopped",
  "depends_on": {
    "gamevault-db": {
      "condition": "service_healthy"
    }
  },
  "ports": [
    "20032:8080"
  ],
  "environment": {
    "DB_HOST": "gamevault-db",
    "DB_USERNAME": "gamevault",
    "DB_PASSWORD": "02386af9-382f-49ad-841b-060735fd14d7"
  },
  "volumes": [
    "big-bear-gamevault_files:/files",
    "big-bear-gamevault_media:/media"
  ]
}
    }
  }
}
