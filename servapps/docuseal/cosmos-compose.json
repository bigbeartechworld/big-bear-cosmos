{
  "cosmos-installer": {
    "routes": [
        {
          "name": "DocuSeal",
          "description": "Web UI",
          "useHost": true,
          "target": "http://docuseal:3000",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "docuseal": {
  "image": "docuseal/docuseal:3.3.2@sha256:fcfa6b2dbf6d8847396f59f8af9591785c66152154337a54d1c1748b4d9366b3",
  "container_name": "docuseal",
  "restart": "unless-stopped",
  "ports": [
    "20031:3000"
  ],
  "volumes": [
    "big-bear-docuseal_data:/data"
  ]
}
    }
  }
}
