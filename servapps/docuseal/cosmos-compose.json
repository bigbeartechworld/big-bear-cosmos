{
  "cosmos-installer": {
    "routes": [
        {
          "name": "DocuSeal",
          "description": "Web UI",
          "useHost": true,
          "target": "http://docuseal:3000",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "docuseal": {
  "image": "docuseal/docuseal:3.3.4@sha256:2786607f1f6eb54f982a926bd78c81ee23b6545e59d1ff548bd672094760621c",
  "container_name": "docuseal",
  "restart": "unless-stopped",
  "ports": [
    "20031:3000"
  ],
  "volumes": [
    "big-bear-docuseal_data:/data"
  ]
}
    }
  }
}
