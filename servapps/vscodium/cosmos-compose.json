{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Vscodium",
          "description": "Web UI",
          "useHost": true,
          "target": "http://vscodium:3000",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "vscodium": {
  "image": "linuxserver/vscodium:1.135.06055@sha256:6d299002029dc6fa2aa3cbc5ee0fcd295fe17d2d805cf1e6ede70d2eaeef4798",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID",
    "TZ": "$TZ"
  },
  "ports": [
    {
      "target": 3000,
      "published": 3000,
      "protocol": "tcp"
    },
    {
      "target": 3001,
      "published": 3001,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/vscodium/config",
      "target": "/config"
    }
  ]
}
    }
  }
}
