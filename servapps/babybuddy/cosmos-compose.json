{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Babybuddy",
          "description": "Web UI",
          "useHost": true,
          "target": "http://babybuddy:8000",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "babybuddy": {
  "image": "linuxserver/babybuddy:2.11.0@sha256:3f244c1a3cd06696c2e8edb40f9fda71a837a77fee06f2f5c2f96ac99c135071",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID",
    "TZ": "$TZ",
    "CSRF_TRUSTED_ORIGINS": ""
  },
  "ports": [
    {
      "target": 8000,
      "published": 8000,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/babybuddy/config",
      "target": "/config"
    }
  ]
}
    }
  }
}
