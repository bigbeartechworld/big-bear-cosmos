{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Lychee",
          "description": "Web UI",
          "useHost": true,
          "target": "http://lychee:80",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "lychee": {
  "image": "linuxserver/lychee:7.11.0@sha256:210c3e382fbe6d1c932348dea4a31384dee2c257e3f4435262afe9658eb85d33",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID",
    "TZ": "$TZ",
    "DB_CONNECTION": "$DB_CONNECTION",
    "DB_HOST": "$DB_HOST",
    "DB_PORT": "$DB_PORT",
    "DB_USERNAME": "$DB_USERNAME",
    "DB_PASSWORD": "$DB_PASSWORD",
    "DB_DATABASE": "$DB_DATABASE",
    "APP_NAME": "$APP_NAME",
    "APP_URL": "$APP_URL",
    "TRUSTED_PROXIES": "$TRUSTED_PROXIES"
  },
  "ports": [
    {
      "target": 80,
      "published": 80,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/lychee/config",
      "target": "/config"
    },
    {
      "type": "bind",
      "source": "/DATA/AppData/lychee/pictures",
      "target": "/pictures"
    }
  ]
}
    }
  }
}
