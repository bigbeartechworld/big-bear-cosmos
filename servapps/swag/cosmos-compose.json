{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Swag",
          "description": "Web UI",
          "useHost": true,
          "target": "http://swag:443",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "swag": {
  "image": "linuxserver/swag:5.8.0@sha256:705de71e24e98f3a2907664d6ae37a83d85001748abedf0d10904b928f191029",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID",
    "TZ": "$TZ",
    "URL": "",
    "VALIDATION": "",
    "SUBDOMAINS": "",
    "CERTPROVIDER": "",
    "CERT_PROFILE": "",
    "DNSPLUGIN": "",
    "PROPAGATION": "",
    "EMAIL": "",
    "ONLY_SUBDOMAINS": "",
    "EXTRA_DOMAINS": "",
    "STAGING": "",
    "DISABLE_F2B": "",
    "SWAG_AUTORELOAD": "",
    "SWAG_AUTORELOAD_WATCHLIST": ""
  },
  "ports": [
    {
      "target": 443,
      "published": 443,
      "protocol": "tcp"
    },
    {
      "target": 80,
      "published": 80,
      "protocol": "tcp"
    },
    {
      "target": 443,
      "published": 443,
      "protocol": "udp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/swag/config",
      "target": "/config"
    }
  ]
}
    }
  }
}
