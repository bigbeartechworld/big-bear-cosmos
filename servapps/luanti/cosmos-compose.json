{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Luanti",
          "description": "Web UI",
          "useHost": true,
          "target": "http://luanti:30000",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "luanti": {
  "image": "linuxserver/luanti:5.17.0@sha256:9411293fa6a84767923d1b310ada55eedfefd883b8093f3f7d64f3726d354e01",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID",
    "TZ": "$TZ",
    "CLI_ARGS": ""
  },
  "ports": [
    {
      "target": 30000,
      "published": 30000,
      "protocol": "udp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/luanti/config/.minetest",
      "target": "/config/.minetest"
    }
  ]
}
    }
  }
}
