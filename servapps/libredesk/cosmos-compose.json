{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Libredesk",
          "description": "Web UI",
          "useHost": true,
          "target": "http://libredesk:9000",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "libredesk": {
  "container_name": "big-bear-libredesk",
  "image": "libredesk/libredesk:v0.7.4-alpha@sha256:61dc7cea8d46d40d75b90a9ea0e4276d7d3092388e36ab7578049784fb96b57e",
  "restart": "unless-stopped",
  "environment": [
    "LIBREDESK_SYSTEM_USER_PASSWORD=\"c6b51a4e-ab9d-4f4f-933e-e96ed3570c1A\""
  ],
  "volumes": [
    "big-bear-libredesk_uploads:/libredesk/uploads:rw",
    "big-bear-libredesk_config:/libredesk/config:rw"
  ],
  "ports": [
    "9000:9000"
  ],
  "depends_on": [
    "big-bear-libredesk-db",
    "big-bear-libredesk-redis"
  ],
  "networks": [
    "big-bear-libredesk-network"
  ],
  "entrypoint": "/bin/sh -c until(cat</libredesk/uploads/.cosmos-run)2>/dev/null;do(IFS=,;s=$1;$s);done;IFS=,;z=$2;$z dummy sleep,1 exec,/libredesk/uploads/.cosmos-run",
  "post_install": [
    "mkdir -p /libredesk/uploads\ncat > /libredesk/uploads/.cosmos-run.tmp <<'BB_COSMOS_RUN'\n#!/bin/sh\n./libredesk --install --idempotent-install --yes --config /libredesk/config/config.toml && ./libredesk --upgrade --yes --config /libredesk/config/config.toml && ./libredesk --config /libredesk/config/config.toml\nBB_COSMOS_RUN\nchmod +x /libredesk/uploads/.cosmos-run.tmp\nmv /libredesk/uploads/.cosmos-run.tmp /libredesk/uploads/.cosmos-run"
  ]
}
    }
  }
}
