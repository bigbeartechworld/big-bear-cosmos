{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Boinc",
          "description": "Web UI",
          "useHost": true,
          "target": "http://boinc:8080",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "boinc": {
  "image": "linuxserver/boinc:18.04.1@sha256:8c81947b3f5771fa15fd47fd7c978e5c6121d516e2c1d3de039808bf9378006b",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID",
    "TZ": "$TZ",
    "PASSWORD": ""
  },
  "ports": [
    {
      "target": 8080,
      "published": 8080,
      "protocol": "tcp"
    },
    {
      "target": 8181,
      "published": 8181,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/boinc/config",
      "target": "/config"
    }
  ]
}
    }
  }
}
