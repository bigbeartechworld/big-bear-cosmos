{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Unifi-controller",
          "description": "Web UI",
          "useHost": true,
          "target": "http://unifi-controller:8443",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "unifi-controller": {
  "image": "linuxserver/unifi-controller:8.0.24@sha256:0ae315a3a45635e443899e30e86bd507c2c48922cb27f4bc7241777885f4650e",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID",
    "TZ": "$TZ",
    "MEM_LIMIT": "",
    "MEM_STARTUP": ""
  },
  "ports": [
    {
      "target": 8443,
      "published": 8443,
      "protocol": "tcp"
    },
    {
      "target": 3478,
      "published": 3478,
      "protocol": "udp"
    },
    {
      "target": 10001,
      "published": 10001,
      "protocol": "udp"
    },
    {
      "target": 8080,
      "published": 8080,
      "protocol": "tcp"
    },
    {
      "target": 1900,
      "published": 1900,
      "protocol": "udp"
    },
    {
      "target": 8843,
      "published": 8843,
      "protocol": "tcp"
    },
    {
      "target": 8880,
      "published": 8880,
      "protocol": "tcp"
    },
    {
      "target": 6789,
      "published": 6789,
      "protocol": "tcp"
    },
    {
      "target": 5514,
      "published": 5514,
      "protocol": "udp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/unifi-controller/config",
      "target": "/config"
    }
  ]
}
    }
  }
}
