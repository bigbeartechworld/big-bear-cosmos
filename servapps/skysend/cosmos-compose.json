{
  "cosmos-installer": {
    "routes": [
        {
          "name": "SkySend",
          "description": "Web UI",
          "useHost": true,
          "target": "http://skysend:3000",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "skysend": {
  "image": "skyfay/skysend:v3.0.1@sha256:aa38fb1213fb564037b728c6a8a5d619a3223dfd3006509b79058384fe76d6fa",
  "container_name": "skysend",
  "restart": "unless-stopped",
  "ports": [
    "23001:3000"
  ],
  "volumes": [
    "big-bear-skysend_data:/data",
    "big-bear-skysend_uploads:/uploads"
  ],
  "environment": {
    "BASE_URL": "http://localhost:23001",
    "DATA_DIR": "/data",
    "UPLOADS_DIR": "/uploads"
  }
}
    }
  }
}
