{
  "cosmos-installer": {
    "routes": [
        {
          "name": "SkySend",
          "description": "Web UI",
          "useHost": true,
          "target": "http://skysend:3000",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "skysend": {
  "image": "skyfay/skysend:v3.1.0@sha256:12ec06476a2a55e8ae5f71f760d9a98546e1b60f99d93a9a2b9c977a62ae69c9",
  "container_name": "skysend",
  "restart": "unless-stopped",
  "ports": [
    "23001:3000"
  ],
  "volumes": [
    "big-bear-skysend_data:/data",
    "big-bear-skysend_uploads:/uploads"
  ],
  "environment": {
    "BASE_URL": "http://localhost:23001",
    "DATA_DIR": "/data",
    "UPLOADS_DIR": "/uploads"
  }
}
    }
  }
}
