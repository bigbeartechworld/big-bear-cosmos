{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Apprise-api",
          "description": "Web UI",
          "useHost": true,
          "target": "http://apprise-api:8000",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "apprise-api": {
  "image": "linuxserver/apprise-api:1.5.4@sha256:9a0d15b11aa1e9979ff05ba21abfd8b5d586d73d4b2d0c81fa406f8b1b39aaee",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID",
    "TZ": "$TZ",
    "APPRISE_ATTACH_SIZE": ""
  },
  "ports": [
    {
      "target": 8000,
      "published": 8000,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/apprise-api/config",
      "target": "/config"
    },
    {
      "type": "bind",
      "source": "/DATA/AppData/apprise-api/attachments",
      "target": "/attachments"
    }
  ]
}
    }
  }
}
