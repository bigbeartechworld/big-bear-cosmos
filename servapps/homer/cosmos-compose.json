{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Homer",
          "description": "Web UI",
          "useHost": true,
          "target": "http://homer:8080",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "homer": {
  "image": "b4bz/homer:v26.08.3@sha256:febc8967c9f7648ec37633ef3ae1ec90dbe8b7c46fecab80299f08f05be7ecb6",
  "container_name": "homer",
  "volumes": [
    "big-bear-homer_assets:/www/assets"
  ],
  "ports": [
    "8080:8080"
  ],
  "user": "1000:1000",
  "environment": [
    "INIT_ASSETS=1"
  ]
}
    }
  }
}
