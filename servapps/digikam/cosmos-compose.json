{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Digikam",
          "description": "Web UI",
          "useHost": true,
          "target": "http://digikam:3000",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "digikam": {
  "image": "linuxserver/digikam:9.1.0@sha256:60d52929d85e5f251eefce7eba161449a773ea35750ef3e1b5dc4b77e092257d",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID",
    "TZ": "$TZ"
  },
  "ports": [
    {
      "target": 3000,
      "published": 3000,
      "protocol": "tcp"
    },
    {
      "target": 3001,
      "published": 3001,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/digikam/config",
      "target": "/config"
    }
  ]
}
    }
  }
}
