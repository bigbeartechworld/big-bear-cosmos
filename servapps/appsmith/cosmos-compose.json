{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Appsmith",
          "description": "Web UI",
          "useHost": true,
          "target": "http://appsmith:1080",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "appsmith": {
  "image": "appsmith/appsmith-ce:v2.4.3@sha256:c50d5b159482981f12e6f8733c3e936376e75d0a518a3cef61b9f4f8a1967696",
  "container_name": "appsmith",
  "ports": [
    "1080:80",
    "10443:443"
  ],
  "volumes": [
    "big-bear-appsmith_stacks:/appsmith-stacks"
  ],
  "restart": "unless-stopped"
}
    }
  }
}
