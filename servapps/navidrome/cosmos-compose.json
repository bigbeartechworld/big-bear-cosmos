{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Navidrome",
          "description": "Web UI",
          "useHost": true,
          "target": "http://navidrome:4533",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "navidrome": {
  "image": "deluan/navidrome:0.64.2@sha256:38dc2727bfcfd5ede290f8ada114fc90368146f265ae4701ddddbcbe2a44ee52",
  "container_name": "navidrome",
  "ports": [
    "4533:4533"
