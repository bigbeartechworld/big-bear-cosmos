{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Plex-meta-manager",
          "description": "Web UI",
          "useHost": true,
          "target": "http://plex-meta-manager:8080",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "plex-meta-manager": {
  "image": "linuxserver/plex-meta-manager:1.21.1@sha256:7703177e6f29ac7bbe555a7f6c21dd05e59af3bd885582933059ce660ae5536f",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID",
    "TZ": "$TZ",
    "PMM_CONFIG": "",
    "PMM_TIME": "",
    "PMM_RUN": "",
    "PMM_TEST": "",
    "PMM_NO_MISSING": ""
  },
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/plex-meta-manager/config",
      "target": "/config"
    }
  ]
}
    }
  }
}
