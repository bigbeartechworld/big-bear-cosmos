{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Cops",
          "description": "Web UI",
          "useHost": true,
          "target": "http://cops:80",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "cops": {
  "image": "linuxserver/cops:4.6.1@sha256:6bff3641983186cae8a78df4ab5c831ca593e2378cc48a7c923452911646d092",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID",
    "TZ": "$TZ"
  },
  "ports": [
    {
      "target": 80,
      "published": 80,
      "protocol": "tcp"
    },
    {
      "target": 443,
      "published": 443,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/cops/config",
      "target": "/config"
    },
    {
      "type": "bind",
      "source": "/DATA/AppData/cops/books",
      "target": "/books"
    }
  ]
}
    }
  }
}
