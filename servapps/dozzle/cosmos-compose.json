{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Dozzle",
          "description": "Web UI",
          "useHost": true,
          "target": "http://dozzle:8888",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "dozzle": {
  "container_name": "big-bear-dozzle",
  "image": "amir20/dozzle:v11.3.2@sha256:0d8cf9702f422d65a7e8ad238785dc6b05b2b9c43c945f6bbdf3358ad5da5f6c",
  "restart": "unless-stopped",
  "volumes": [
    "/var/run/docker.sock:/var/run/docker.sock"
  ],
  "ports": [
    "8888:8080"
  ]
}
    }
  }
}
