{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Dozzle",
          "description": "Web UI",
          "useHost": true,
          "target": "http://dozzle:8888",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "dozzle": {
  "container_name": "big-bear-dozzle",
  "image": "amir20/dozzle:v10.6.13@sha256:9b13386276490c41faf41fbe7f477964d2a6ba95dd087e7d22a890a65e58c841",
  "restart": "unless-stopped",
  "volumes": [
    "/var/run/docker.sock:/var/run/docker.sock"
  ],
  "ports": [
    "8888:8080"
  ]
}
    }
  }
}
