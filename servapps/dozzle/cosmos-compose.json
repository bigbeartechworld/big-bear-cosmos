{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Dozzle",
          "description": "Web UI",
          "useHost": true,
          "target": "http://dozzle:8888",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "dozzle": {
  "container_name": "big-bear-dozzle",
  "image": "amir20/dozzle:v11.1.1@sha256:c90494cbc3a9ca959634b89fdb3fdecbcbae1f690d7a567d0d356c6fda1d957c",
  "restart": "unless-stopped",
  "volumes": [
    "/var/run/docker.sock:/var/run/docker.sock"
  ],
  "ports": [
    "8888:8080"
  ]
}
    }
  }
}
