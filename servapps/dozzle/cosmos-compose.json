{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Dozzle",
          "description": "Web UI",
          "useHost": true,
          "target": "http://dozzle:8888",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "dozzle": {
  "container_name": "big-bear-dozzle",
  "image": "amir20/dozzle:v11.3.3@sha256:6d9e194587c20660f73967ee8567ce8e2e9e2e17046b0c95586a37a970b1d5ed",
  "restart": "unless-stopped",
  "volumes": [
    "/var/run/docker.sock:/var/run/docker.sock"
  ],
  "ports": [
    "8888:8080"
  ]
}
    }
  }
}
