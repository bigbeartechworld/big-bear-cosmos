{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Calibre",
          "description": "Web UI",
          "useHost": true,
          "target": "http://calibre:8080",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "calibre": {
  "image": "linuxserver/calibre:9.17.0@sha256:b198fc03a6abc6be7e251a9958e50e74634b00e447c7b25e92c191c8077ba378",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID",
    "TZ": "$TZ",
    "CUSTOM_USER": "$CUSTOM_USER",
    "PASSWORD": "$PASSWORD",
    "CLI_ARGS": ""
  },
  "ports": [
    {
      "target": 8080,
      "published": 8080,
      "protocol": "tcp"
    },
    {
      "target": 8181,
      "published": 8181,
      "protocol": "tcp"
    },
    {
      "target": 8081,
      "published": 8081,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/calibre/config",
      "target": "/config"
    }
  ]
}
    }
  }
}
