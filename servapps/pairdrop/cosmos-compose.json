{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Pairdrop",
          "description": "Web UI",
          "useHost": true,
          "target": "http://pairdrop:3000",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "pairdrop": {
  "image": "linuxserver/pairdrop:1.11.2@sha256:4a87eb38032ad6fd58da193cca6c625c6215bfef9760b07cf8a8d5550dc02359",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID",
    "TZ": "$TZ",
    "RATE_LIMIT": "",
    "WS_FALLBACK": "",
    "RTC_CONFIG": "",
    "DEBUG_MODE": ""
  },
  "ports": [
    {
      "target": 3000,
      "published": 3000,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/pairdrop/config",
      "target": "/config"
    }
  ]
}
    }
  }
}
