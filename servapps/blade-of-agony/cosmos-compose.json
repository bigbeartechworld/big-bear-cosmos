{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Blade-of-agony",
          "description": "Web UI",
          "useHost": true,
          "target": "http://blade-of-agony:3000",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "blade-of-agony": {
  "image": "linuxserver/blade-of-agony:3.1.20261001@sha256:72d61ee18b609935c632df57cfbd420b62cc7ffc93c4ef4d83c81c841a0e5ebd",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID",
    "TZ": "$TZ"
  },
  "ports": [
    {
      "target": 3000,
      "published": 3000,
      "protocol": "tcp"
    },
    {
      "target": 3001,
      "published": 3001,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/blade-of-agony/config",
      "target": "/config"
    }
  ]
}
    }
  }
}
