{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Blade-of-agony",
          "description": "Web UI",
          "useHost": true,
          "target": "http://blade-of-agony:3000",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "blade-of-agony": {
  "image": "linuxserver/blade-of-agony:3.1.20261008@sha256:cef2f190c8ce4676a8d413927825b4ba366bac6d7ee1d75a5a15f27ef21cc7c5",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID",
    "TZ": "$TZ"
  },
  "ports": [
    {
      "target": 3000,
      "published": 3000,
      "protocol": "tcp"
    },
    {
      "target": 3001,
      "published": 3001,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/blade-of-agony/config",
      "target": "/config"
    }
  ]
}
    }
  }
}
