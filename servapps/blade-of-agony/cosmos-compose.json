{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Blade-of-agony",
          "description": "Web UI",
          "useHost": true,
          "target": "http://blade-of-agony:3000",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "blade-of-agony": {
  "image": "linuxserver/blade-of-agony:3.1.20260917@sha256:8926be7bc8b47c278a1436c5aaef79170be601adb8854d5e5156ea6de0607984",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID",
    "TZ": "$TZ"
  },
  "ports": [
    {
      "target": 3000,
      "published": 3000,
      "protocol": "tcp"
    },
    {
      "target": 3001,
      "published": 3001,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/blade-of-agony/config",
      "target": "/config"
    }
  ]
}
    }
  }
}
