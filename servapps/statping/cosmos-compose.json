{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Statping",
          "description": "Web UI",
          "useHost": true,
          "target": "http://statping:48107",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "statping": {
  "image": "statping/statping:v0.90.74",
  "restart": "always",
  "depends_on": [
    "db"
  ],
  "environment": {
    "VIRTUAL_PORT": 8080,
    "DB_CONN": "postgres",
    "DB_HOST": "db",
    "DB_USER": "bigbear",
    "DB_PASS": "dc640cd4-0450-4a94-aedb-ee5b43b32a45",
    "DB_DATABASE": "casaos",
    "NAME": "",
    "DESCRIPTION": ""
  },
  "ports": [
    {
      "target": 8080,
      "published": 48107,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/$AppID/app",
      "target": "/app"
    }
  ]
}
    }
  }
}
