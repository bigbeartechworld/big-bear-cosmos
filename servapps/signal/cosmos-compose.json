{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Signal",
          "description": "Web UI",
          "useHost": true,
          "target": "http://signal:3000",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "signal": {
  "image": "linuxserver/signal:8.27.0@sha256:bf95b267690bb692a9a5db8c7cea02caddbea330da45a776838ce1c39f63990c",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID",
    "TZ": "$TZ"
  },
  "ports": [
    {
      "target": 3000,
      "published": 3000,
      "protocol": "tcp"
    },
    {
      "target": 3001,
      "published": 3001,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/signal/config",
      "target": "/config"
    }
  ]
}
    }
  }
}
