{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Doublecommander",
          "description": "Web UI",
          "useHost": true,
          "target": "http://doublecommander:3000",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "doublecommander": {
  "image": "linuxserver/doublecommander:version-8143f818@sha256:efd6e23446d4eca9a29e3ff81b1209e18a13465fa50073d4de4fb51e233a98ac",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID",
    "TZ": "$TZ"
  },
  "ports": [
    {
      "target": 3000,
      "published": 3000,
      "protocol": "tcp"
    },
    {
      "target": 3001,
      "published": 3001,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/doublecommander/config",
      "target": "/config"
    },
    {
      "type": "bind",
      "source": "/DATA/AppData/doublecommander/data",
      "target": "/data"
    }
  ]
}
    }
  }
}
