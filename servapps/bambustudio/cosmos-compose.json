{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Bambustudio",
          "description": "Web UI",
          "useHost": true,
          "target": "http://bambustudio:3000",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "bambustudio": {
  "image": "linuxserver/bambustudio:02.08.04@sha256:81f70ad79762348d948a32ee50a593392a86b38ce3742d47936e5f43d4b82602",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID",
    "TZ": "$TZ",
    "DARK_MODE": ""
  },
  "ports": [
    {
      "target": 3000,
      "published": 3000,
      "protocol": "tcp"
    },
    {
      "target": 3001,
      "published": 3001,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/bambustudio/config",
      "target": "/config"
    }
  ]
}
    }
  }
}
