{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Bambustudio",
          "description": "Web UI",
          "useHost": true,
          "target": "http://bambustudio:3000",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "bambustudio": {
  "image": "linuxserver/bambustudio:02.08.03@sha256:f6b7d67685a933d799e97872f72366a9250de068a73e2cc81d1d130f5e5ae348",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID",
    "TZ": "$TZ",
    "DARK_MODE": ""
  },
  "ports": [
    {
      "target": 3000,
      "published": 3000,
      "protocol": "tcp"
    },
    {
      "target": 3001,
      "published": 3001,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/bambustudio/config",
      "target": "/config"
    }
  ]
}
    }
  }
}
