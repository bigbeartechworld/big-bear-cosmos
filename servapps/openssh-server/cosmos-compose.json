{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Openssh-server",
          "description": "Web UI",
          "useHost": true,
          "target": "http://openssh-server:2222",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "openssh-server": {
  "image": "linuxserver/openssh-server:version-10.3_p1-r1@sha256:0f535b0faa7448511b23528165e9fbd4f1fe563b861b3dcaa5ddb0ddbfe2254c",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID",
    "TZ": "$TZ",
    "PUBLIC_KEY": "",
    "PUBLIC_KEY_FILE": "",
    "PUBLIC_KEY_DIR": "",
    "PUBLIC_KEY_URL": "",
    "SUDO_ACCESS": "",
    "PASSWORD_ACCESS": "",
    "USER_PASSWORD": "",
    "USER_PASSWORD_FILE": "",
    "USER_NAME": "",
    "LOG_STDOUT": ""
  },
  "ports": [
    {
      "target": 2222,
      "published": 2222,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/openssh-server/config",
      "target": "/config"
    }
  ]
}
    }
  }
}
