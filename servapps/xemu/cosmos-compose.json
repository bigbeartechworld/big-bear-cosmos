{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Xemu",
          "description": "Web UI",
          "useHost": true,
          "target": "http://xemu:3000",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "xemu": {
  "image": "linuxserver/xemu:0.8.134@sha256:6904497c2cc7660e5e356e00a22aed842046584be1771ae0639a8c6a669de4a3",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID",
    "TZ": "$TZ"
  },
  "ports": [
    {
      "target": 3000,
      "published": 3000,
      "protocol": "tcp"
    },
    {
      "target": 3001,
      "published": 3001,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/xemu/config",
      "target": "/config"
    }
  ]
}
    }
  }
}
