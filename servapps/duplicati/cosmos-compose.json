{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Duplicati",
          "description": "Web UI",
          "useHost": true,
          "target": "http://duplicati:8200",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "duplicati": {
  "image": "linuxserver/duplicati:2.4.0@sha256:047b962ff7e235dbada19cadb5c0df55bcd63486ece381b2976b094081dabe61",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID",
    "TZ": "$TZ",
    "SETTINGS_ENCRYPTION_KEY": "",
    "CLI_ARGS": "",
    "DUPLICATI__WEBSERVICE_PASSWORD": ""
  },
  "ports": [
    {
      "target": 8200,
      "published": 8200,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/duplicati/config",
      "target": "/config"
    },
    {
      "type": "bind",
      "source": "/DATA/AppData/duplicati/backups",
      "target": "/backups"
    },
    {
      "type": "bind",
      "source": "/DATA/AppData/duplicati/source",
      "target": "/source"
    }
  ]
}
    }
  }
}
