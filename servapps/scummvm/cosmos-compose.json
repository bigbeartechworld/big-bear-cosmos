{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Scummvm",
          "description": "Web UI",
          "useHost": true,
          "target": "http://scummvm:3000",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "scummvm": {
  "image": "linuxserver/scummvm:2026.4.0@sha256:4a03c7f05c56a3fbdbec49557f3f17becd7d5a7d770710aa6b59b8654909f59d",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID",
    "TZ": "$TZ"
  },
  "ports": [
    {
      "target": 3000,
      "published": 3000,
      "protocol": "tcp"
    },
    {
      "target": 3001,
      "published": 3001,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/scummvm/config",
      "target": "/config"
    }
  ]
}
    }
  }
}
