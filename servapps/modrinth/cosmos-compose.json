{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Modrinth",
          "description": "Web UI",
          "useHost": true,
          "target": "http://modrinth:3000",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "modrinth": {
  "image": "linuxserver/modrinth:0.21.8@sha256:bdfdca5cd36c3b4736294a91063e03fbd4d7b1fa28c64932ab5ed4fc576f1b14",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID",
    "TZ": "$TZ"
  },
  "ports": [
    {
      "target": 3000,
      "published": 3000,
      "protocol": "tcp"
    },
    {
      "target": 3001,
      "published": 3001,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/modrinth/config",
      "target": "/config"
    }
  ]
}
    }
  }
}
