{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Calibre-web",
          "description": "Web UI",
          "useHost": true,
          "target": "http://calibre-web:8083",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "calibre-web": {
  "image": "linuxserver/calibre-web:0.6.27@sha256:e7debaaec01a02a9e524d888209c590ab5c77a25546723f9b73a3bd32d946cfc",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID",
    "TZ": "$TZ",
    "DOCKER_MODS": "",
    "OAUTHLIB_RELAX_TOKEN_SCOPE": ""
  },
  "ports": [
    {
      "target": 8083,
      "published": 8083,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/calibre-web/config",
      "target": "/config"
    },
    {
      "type": "bind",
      "source": "/DATA/AppData/calibre-web/books",
      "target": "/books"
    }
  ]
}
    }
  }
}
