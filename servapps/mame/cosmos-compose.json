{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Mame",
          "description": "Web UI",
          "useHost": true,
          "target": "http://mame:3000",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "mame": {
  "image": "linuxserver/mame:version-0.289dfsg1-0@sha256:9460e65352a4668f775f45bd68ea44f819515d57065bc07560700153c8644e8d",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID",
    "TZ": "$TZ"
  },
  "ports": [
    {
      "target": 3000,
      "published": 3000,
      "protocol": "tcp"
    },
    {
      "target": 3001,
      "published": 3001,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/mame/config",
      "target": "/config"
    },
    {
      "type": "bind",
      "source": "/DATA/AppData/mame/mame:ro",
      "target": "/mame:ro"
    }
  ]
}
    }
  }
}
