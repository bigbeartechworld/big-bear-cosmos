{
  "cosmos-installer": {
    "routes": [
        {
          "name": "DBGate",
          "description": "Web UI",
          "useHost": true,
          "target": "http://dbgate:3000",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "dbgate": {
  "container_name": "big-bear-dbgate",
  "image": "dbgate/dbgate:7.3.1-alpine@sha256:09c37ff3ee5c53abd6c6de887a81ab329935fe3bcef789337cd996c3e887c7b1",
  "restart": "unless-stopped",
  "volumes": [
    "big-bear-dbgate_config:/root/.dbgate"
  ],
  "ports": [
    "3000:3000"
  ]
}
    }
  }
}
