{
  "cosmos-installer": {
    "routes": [
        {
          "name": "DBGate",
          "description": "Web UI",
          "useHost": true,
          "target": "http://dbgate:3000",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "dbgate": {
  "container_name": "big-bear-dbgate",
  "image": "dbgate/dbgate:7.3.0-alpine@sha256:6686e4839af324a5f21f6703ce21505bbecb12e9a5e72670de18dd5e8486b50a",
  "restart": "unless-stopped",
  "volumes": [
    "big-bear-dbgate_config:/root/.dbgate"
  ],
  "ports": [
    "3000:3000"
  ]
}
    }
  }
}
