{
  "cosmos-installer": {
    "routes": [
        {
          "name": "DBGate",
          "description": "Web UI",
          "useHost": true,
          "target": "http://dbgate:3000",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "dbgate": {
  "container_name": "big-bear-dbgate",
  "image": "dbgate/dbgate:7.3.2-alpine@sha256:16adb42330dd7043d4418887b948ca066f9567e252ca6368e62388a5df9d074e",
  "restart": "unless-stopped",
  "volumes": [
    "big-bear-dbgate_config:/root/.dbgate"
  ],
  "ports": [
    "3000:3000"
  ]
}
    }
  }
}
