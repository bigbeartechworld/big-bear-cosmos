{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Krita",
          "description": "Web UI",
          "useHost": true,
          "target": "http://krita:3000",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "krita": {
  "image": "linuxserver/krita:5.3.4@sha256:965181ce18e3c9c1ace8fdd88c56cf1c381809ebc14a934b34d191ed09d123cd",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID",
    "TZ": "$TZ"
  },
  "ports": [
    {
      "target": 3000,
      "published": 3000,
      "protocol": "tcp"
    },
    {
      "target": 3001,
      "published": 3001,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/krita/config",
      "target": "/config"
    }
  ]
}
    }
  }
}
