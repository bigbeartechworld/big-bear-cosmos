{
  "cosmos-installer": {
    "routes": [
        {
          "name": "OmniRoute",
          "description": "Web UI",
          "useHost": true,
          "target": "http://omniroute:20128",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "omniroute": {
  "image": "diegosouzapw/omniroute:3.8.52@sha256:b08a12e876baa8a5ccadd1ebbe346fe7267dba3b1c9f4fd6bb02070fae41ab6c",
  "container_name": "omniroute",
  "restart": "unless-stopped",
  "stop_grace_period": "40s",
  "environment": {
    "DATA_DIR": "/app/data",
    "REDIS_URL": "redis://redis:6379",
    "REQUIRE_API_KEY": "true",
    "INITIAL_PASSWORD": "0efefa3c-54ae-4848-b7bc-295f91483fe7",
    "OMNIROUTE_MEMORY_MB": "2048"
  },
  "ports": [
    "20128:20128",
    "20129:20129",
    "20132:20132"
  ],
  "volumes": [
    "big-bear-omniroute_data:/app/data"
  ],
  "depends_on": {
    "redis": {
      "condition": "service_healthy"
    }
  },
  "healthcheck": {
    "test": [
      "CMD",
      "node",
      "healthcheck.mjs"
    ],
    "interval": "30s",
    "timeout": "5s",
    "retries": 3,
    "start_period": "20s"
  }
}
    }
  }
}
