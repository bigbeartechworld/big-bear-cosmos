{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Draw.io",
          "description": "Web UI",
          "useHost": true,
          "target": "http://drawio:8080",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "drawio": {
  "image": "jgraph/drawio:32.3.0@sha256:24fee0fe0044558e5fbdd5f2819b0e4c9a33cc852c0c3e40b674cab216df574a",
  "container_name": "drawio",
  "ports": [
    "8080:8080"
  ],
  "restart": "unless-stopped"
}
    }
  }
}
