{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Draw.io",
          "description": "Web UI",
          "useHost": true,
          "target": "http://drawio:8080",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "drawio": {
  "image": "jgraph/drawio:32.6.1@sha256:3d0a5a5ffb4f76abcecd9d17ae1373e3eefd0db07b657c545637dc9c6a7412e1",
  "container_name": "drawio",
  "ports": [
    "8080:8080"
  ],
  "restart": "unless-stopped"
}
    }
  }
}
