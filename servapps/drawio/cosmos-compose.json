      ],
    "services": {
      "drawio": {
  "image": "jgraph/drawio:32.4.1@sha256:d2e7024e5e5a5d3ab3db6eb018ecb66849253ef95d7ee82d400facb3ca7c3384",
  "container_name": "drawio",
