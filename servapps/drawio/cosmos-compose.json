{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Draw.io",
          "description": "Web UI",
          "useHost": true,
          "target": "http://drawio:8080",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "drawio": {
  "image": "jgraph/drawio:32.5.5@sha256:16296fe9fd09eff92a3808cc674ce1883712c1b0bae5d48ccc30f9abf13c578b",
  "container_name": "drawio",
  "ports": [
    "8080:8080"
  ],
  "restart": "unless-stopped"
}
    }
  }
}
