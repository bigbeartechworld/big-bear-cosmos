{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Draw.io",
          "description": "Web UI",
          "useHost": true,
          "target": "http://drawio:8080",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "drawio": {
  "image": "jgraph/drawio:32.0.1@sha256:a9900b0797a594b1a7096953651c1449352aec0713d0d89fae1ce24fe9ae70f0",
  "container_name": "drawio",
  "ports": [
    "8080:8080"
  ],
  "restart": "unless-stopped"
}
    }
  }
}
