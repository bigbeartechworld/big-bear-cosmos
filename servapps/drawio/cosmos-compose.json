{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Draw.io",
          "description": "Web UI",
          "useHost": true,
          "target": "http://drawio:8080",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "drawio": {
  "image": "jgraph/drawio:32.0.2@sha256:01a60ec393578bd20194b4da6272fd0b2ae679c57f2027ad478100d96d81965b",
  "container_name": "drawio",
  "ports": [
    "8080:8080"
  ],
  "restart": "unless-stopped"
}
    }
  }
}
