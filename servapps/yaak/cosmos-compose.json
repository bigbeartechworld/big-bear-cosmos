{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Yaak",
          "description": "Web UI",
          "useHost": true,
          "target": "http://yaak:3000",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "yaak": {
  "image": "linuxserver/yaak:2026.9.0@sha256:0a5d99db725c0ba19974490d70b294348bd8ed5059f6564e94759bb65c6f21ca",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID",
    "TZ": "$TZ"
  },
  "ports": [
    {
      "target": 3000,
      "published": 3000,
      "protocol": "tcp"
    },
    {
      "target": 3001,
      "published": 3001,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/yaak/config",
      "target": "/config"
    }
  ]
}
    }
  }
}
