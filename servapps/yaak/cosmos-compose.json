{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Yaak",
          "description": "Web UI",
          "useHost": true,
          "target": "http://yaak:3000",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "yaak": {
  "image": "linuxserver/yaak:2026.7.1@sha256:f4166075780b9815d2c4e7b55ede7c26f37580491abe3a93bba23163fc3b8e69",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID",
    "TZ": "$TZ"
  },
  "ports": [
    {
      "target": 3000,
      "published": 3000,
      "protocol": "tcp"
    },
    {
      "target": 3001,
      "published": 3001,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/yaak/config",
      "target": "/config"
    }
  ]
}
    }
  }
}
