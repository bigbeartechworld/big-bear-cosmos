{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Privatebin",
          "description": "Web UI",
          "useHost": true,
          "target": "http://privatebin:48106",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "privatebin": {
  "image": "privatebin/nginx-fpm-alpine:2.0.6",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID"
  },
  "ports": [
    {
      "target": 8080,
      "published": 48106,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/$AppID/data",
      "target": "/srv/data"
    },
    {
      "type": "bind",
      "source": "/DATA/AppData/$AppID/config",
      "target": "/srv/cfg"
    }
  ]
}
    }
  }
}
