{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Rustdesk Server",
          "description": "Web UI",
          "useHost": true,
          "target": "http://rustdesk-server:8080",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "rustdesk-server": {
  "image": "rustdesk/rustdesk-server:1",
  "command": "hbbs",
  "volumes": [
    "/DATA/AppData/rustdesk/data:/root"
  ],
  "network_mode": "host",
  "depends_on": [
    "hbbr"
  ],
  "restart": "unless-stopped"
}
    }
  }
}
