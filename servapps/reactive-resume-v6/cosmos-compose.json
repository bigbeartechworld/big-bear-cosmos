{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Reactive Resume v6",
          "description": "Web UI",
          "useHost": true,
          "target": "http://reactive-resume-v6:3028",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "reactive-resume-v6": {
  "container_name": "big-bear-reactive-resume-v6",
  "image": "amruthpillai/reactive-resume:v6.0.5@sha256:59b0d4406ec4a9ed78f9327662fa36109c61a1ef11caa6a8c0b425e6ae0ef376",
  "restart": "unless-stopped",
  "ports": [
    "3028:3000"
  ],
  "depends_on": {
    "big-bear-reactive-resume-v6-db": {
      "condition": "service_healthy"
    }
  },
  "environment": {
    "APP_URL": "http://localhost:3028",
    "AUTH_SECRET": "access_token_secret",
    "DATABASE_URL": "postgresql://postgres:postgres@big-bear-reactive-resume-v6-db:5432/postgres"
  },
  "volumes": [
    "big-bear-reactive-resume-v6_data:/app/data"
  ],
  "networks": [
    "big-bear-reactive-resume-v6-network"
  ]
}
    }
  }
}
