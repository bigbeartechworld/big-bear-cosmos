{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Portainer Agent",
          "description": "Web UI",
          "useHost": true,
          "target": "http://portainer-agent:9001",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "portainer-agent": {
  "container_name": "portainer-agent",
  "image": "portainer/agent:2.44.0@sha256:2f8058d946a5dc8f70933afc06726e34de6d7f12a3fd5db1cf7987c327aea2d1",
  "network_mode": "bridge",
  "ports": [
    "9001:9001"
  ],
  "volumes": [
    "/var/run/docker.sock:/var/run/docker.sock",
    "/var/lib/docker/volumes:/var/lib/docker/volumes"
  ]
}
    }
  }
}
