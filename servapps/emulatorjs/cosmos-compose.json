{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Emulatorjs",
          "description": "Web UI",
          "useHost": true,
          "target": "http://emulatorjs:3000",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "emulatorjs": {
  "image": "linuxserver/emulatorjs:1.9.2@sha256:b7003f7d4f383dd32d210ba08f24c840276fdf92c211bd18a798d47647311290",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID",
    "TZ": "$TZ",
    "SUBFOLDER": ""
  },
  "ports": [
    {
      "target": 3000,
      "published": 3000,
      "protocol": "tcp"
    },
    {
      "target": 80,
      "published": 80,
      "protocol": "tcp"
    },
    {
      "target": 4001,
      "published": 4001,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/emulatorjs/config",
      "target": "/config"
    },
    {
      "type": "bind",
      "source": "/DATA/AppData/emulatorjs/data",
      "target": "/data"
    }
  ]
}
    }
  }
}
