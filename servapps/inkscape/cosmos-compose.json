{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Inkscape",
          "description": "Web UI",
          "useHost": true,
          "target": "http://inkscape:3000",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "inkscape": {
  "image": "linuxserver/inkscape:1.4.2@sha256:31db35960100e924a3f6bd836c7b49e1dd8bc63858acef1618455fda4e6c337e",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID",
    "TZ": "$TZ"
  },
  "ports": [
    {
      "target": 3000,
      "published": 3000,
      "protocol": "tcp"
    },
    {
      "target": 3001,
      "published": 3001,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/inkscape/config",
      "target": "/config"
    }
  ]
}
    }
  }
}
