{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Wireguard",
          "description": "Web UI",
          "useHost": true,
          "target": "http://wireguard:51820",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "wireguard": {
  "image": "linuxserver/wireguard:1.0.20260223@sha256:e2f655e1956a6db476bc879bf721f3f8bfed49c6d8fbcf39495d7ecb991d8228",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID",
    "TZ": "$TZ",
    "SERVERURL": "",
    "SERVERPORT": "",
    "PEERS": "",
    "PEERDNS": "",
    "INTERNAL_SUBNET": "",
    "ALLOWEDIPS": "",
    "PERSISTENTKEEPALIVE_PEERS": "",
    "LOG_CONFS": ""
  },
  "ports": [
    {
      "target": 51820,
      "published": 51820,
      "protocol": "udp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/wireguard/config",
      "target": "/config"
    },
    {
      "type": "bind",
      "source": "/lib/modules",
      "target": "/lib/modules"
    }
  ]
}
    }
  }
}
