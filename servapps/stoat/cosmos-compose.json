{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Stoat",
          "description": "Web UI",
          "useHost": true,
          "target": "http://stoat:80",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "stoat": {
  "image": "caddy:2.11.7@sha256:3095ad245c353e3bdb27a38f22a095c1cfa9e295ab21c0214c3e72b0e2960525",
  "restart": "unless-stopped",
  "environment": {
    "HOSTNAME": "https://stoat.localhost"
  },
  "ports": [
    "20001:80",
    "20002:443"
  ],
  "configs": [
    {
      "source": "caddyfile",
      "target": "/etc/caddy/Caddyfile"
    }
  ],
  "volumes": [
    "big-bear-stoat_caddy_data:/data",
    "big-bear-stoat_caddy_config:/config"
  ],
  "networks": {
    "default": {
      "aliases": [
        "stoat.localhost",
        "stoat"
      ]
    }
  }
}
    }
  }
}
