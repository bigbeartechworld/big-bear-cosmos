{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Librewolf",
          "description": "Web UI",
          "useHost": true,
          "target": "http://librewolf:3000",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "librewolf": {
  "image": "linuxserver/librewolf:157.0.1@sha256:91c034c43f4e00b92fa39c0d0cc470ba9554bb8ffd5db4008881b4e700241a64",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID",
    "TZ": "$TZ",
    "LIBREWOLF_CLI": ""
  },
  "ports": [
    {
      "target": 3000,
      "published": 3000,
      "protocol": "tcp"
    },
    {
      "target": 3001,
      "published": 3001,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/librewolf/config",
      "target": "/config"
    }
  ]
}
    }
  }
}
