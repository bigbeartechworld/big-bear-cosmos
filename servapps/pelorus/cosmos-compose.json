{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Pelorus",
          "description": "Web UI",
          "useHost": true,
          "target": "http://pelorus:3001",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "pelorus": {
  "image": "linuxserver/pelorus:0.2.3@sha256:363dca5d187580176cbbca6e0592d9aeaa674824d095850bac8dcb443ba11dc4",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID",
    "TZ": "$TZ"
  },
  "ports": [
    {
      "target": 3001,
      "published": 3001,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/pelorus/config",
      "target": "/config"
    }
  ]
}
    }
  }
}
