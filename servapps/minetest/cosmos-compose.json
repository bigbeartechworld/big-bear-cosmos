{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Minetest",
          "description": "Web UI",
          "useHost": true,
          "target": "http://minetest:30000",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "minetest": {
  "image": "linuxserver/minetest:5.10.0@sha256:781e50480e4027145d2c81f5cbf6632df40ef0a2b5781682cd149ce58bea305e",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID",
    "TZ": "$TZ",
    "CLI_ARGS": ""
  },
  "ports": [
    {
      "target": 30000,
      "published": 30000,
      "protocol": "udp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/minetest/config/.minetest",
      "target": "/config/.minetest"
    }
  ]
}
    }
  }
}
