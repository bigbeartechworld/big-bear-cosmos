{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Winegui",
          "description": "Web UI",
          "useHost": true,
          "target": "http://winegui:3000",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "winegui": {
  "image": "linuxserver/winegui:4.5.1@sha256:7f052e9a577cd8bcd09b704ddbd909e85839d25507559f967ebba4c6c242b670",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID",
    "TZ": "$TZ"
  },
  "ports": [
    {
      "target": 3000,
      "published": 3000,
      "protocol": "tcp"
    },
    {
      "target": 3001,
      "published": 3001,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/winegui/config",
      "target": "/config"
    }
  ]
}
    }
  }
}
