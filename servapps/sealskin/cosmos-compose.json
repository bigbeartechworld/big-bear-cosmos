{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Sealskin",
          "description": "Web UI",
          "useHost": true,
          "target": "http://sealskin:8443",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "sealskin": {
  "image": "linuxserver/sealskin:0.3.2@sha256:ca74767ab9b545860c30049a89d15f29061971c713952ba41673dcf8bfc969cd",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID",
    "TZ": "$TZ",
    "HOST_URL": ""
  },
  "ports": [
    {
      "target": 8443,
      "published": 8443,
      "protocol": "tcp"
    },
    {
      "target": 8000,
      "published": 8000,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/sealskin/config",
      "target": "/config"
    },
    {
      "type": "bind",
      "source": "/DATA/AppData/sealskin/storage",
      "target": "/storage"
    },
    {
      "type": "bind",
      "source": "/var/run/docker.sock",
      "target": "/var/run/docker.sock"
    }
  ]
}
    }
  }
}
