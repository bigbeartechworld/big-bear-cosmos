{
  "cosmos-installer": {
    "routes": [
        {
          "name": "netboot.xyz",
          "description": "Web UI",
          "useHost": true,
          "target": "http://netboot-xyz:3000",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "netboot-xyz": {
  "image": "ghcr.io/netbootxyz/netbootxyz:0.7.6-nbxyz24@sha256:7bd0964fd3648cd3323772ad6ad8b0a507afe797385e4c0f587a8c23972ee4e3",
  "container_name": "netboot-xyz",
  "ports": [
    "3000:3000",
    "69:69/udp",
    "8080:80"
  ],
  "volumes": [
    "big-bear-netboot-xyz_config:/config",
    "big-bear-netboot-xyz_assets:/assets"
  ],
  "environment": [
    "NGINX_PORT=80",
    "WEB_APP_PORT=3000",
    "TZ=UTC"
  ],
  "restart": "unless-stopped"
}
    }
  }
}
