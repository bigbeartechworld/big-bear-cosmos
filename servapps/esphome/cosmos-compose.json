{
  "cosmos-installer": {
    "routes": [
        {
          "name": "ESPHome",
          "description": "Web UI",
          "useHost": true,
          "target": "http://esphome:6052",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "esphome": {
  "image": "esphome/esphome:2026.9",
  "restart": "unless-stopped",
  "network_mode": "host",
  "privileged": true,
  "environment": {
    "USERNAME": "bigbear",
    "PASSWORD": "f87989f5-0dd4-44af-a286-6c6a325001cc"
  },
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/esphome/config",
      "target": "/config"
    },
    {
      "type": "bind",
      "source": "/etc/localtime",
      "target": "/etc/localtime",
      "read_only": true
    }
  ]
}
    }
  }
}
