{
  "cosmos-installer": {
    "routes": [
        {
          "name": "openGym",
          "description": "Web UI",
          "useHost": true,
          "target": "http://opengym:80",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "opengym": {
  "image": "registry.gitlab.com/duartesantos8/opengym/web:1.3.9@sha256:eb97d4f78a9d495a41d0181440ae3394feab41e7200b7a4a36099cee36e80036",
  "container_name": "opengym",
  "restart": "unless-stopped",
  "depends_on": {
    "media": {
      "condition": "service_completed_successfully"
    },
    "api": {
      "condition": "service_started"
    }
  },
  "ports": [
    "20808:80"
  ],
  "environment": {
    "NGINX_PORT": "80",
    "BACKEND": "api",
    "PORT": "3000",
    "RESOLVER": "127.0.0.11",
    "CF_CONNECTING_IP": "",
    "BASE_PATH": "",
    "MEDIA_UPLOAD_MAX": "48m"
  },
  "volumes": [
    "big-bear-opengym_media_img:/usr/share/nginx/html/img:ro",
    "big-bear-opengym_media_gif:/usr/share/nginx/html/gif:ro"
  ]
}
    }
  }
}
