{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Synclounge",
          "description": "Web UI",
          "useHost": true,
          "target": "http://synclounge:8088",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "synclounge": {
  "image": "linuxserver/synclounge:5.2.35@sha256:f8a7bc27a1b90c2c02e4745f37c5d1bda7e04f45d5bb89f51e7b07cd8fe92e81",
  "restart": "unless-stopped",
  "environment": {
    "AUTH_LIST": ""
  },
  "ports": [
    {
      "target": 8088,
      "published": 8088,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/synclounge/config",
      "target": "/config"
    }
  ]
}
    }
  }
}
