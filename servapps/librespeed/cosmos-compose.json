{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Librespeed",
          "description": "Web UI",
          "useHost": true,
          "target": "http://librespeed:80",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "librespeed": {
  "image": "linuxserver/librespeed:6.3.0@sha256:05c1ca8215f958b674e8fa1c2ea43483efa54dae8f1dbe40c907af66821fdcae",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID",
    "TZ": "$TZ",
    "PASSWORD": "",
    "CUSTOM_RESULTS": "",
    "DB_TYPE": "",
    "DB_NAME": "",
    "DB_HOSTNAME": "",
    "DB_USERNAME": "",
    "DB_PASSWORD": "",
    "DB_PORT": "",
    "IPINFO_APIKEY": ""
  },
  "ports": [
    {
      "target": 80,
      "published": 80,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/librespeed/config",
      "target": "/config"
    }
  ]
}
    }
  }
}
