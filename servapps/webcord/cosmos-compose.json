{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Webcord",
          "description": "Web UI",
          "useHost": true,
          "target": "http://webcord:3000",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "webcord": {
  "image": "linuxserver/webcord:4.14.0@sha256:9e58513901ec68387a81ac76f159bd262136e914ec5ae6d0c4a538fe8ff81fec",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID",
    "TZ": "$TZ"
  },
  "ports": [
    {
      "target": 3000,
      "published": 3000,
      "protocol": "tcp"
    },
    {
      "target": 3001,
      "published": 3001,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/webcord/config",
      "target": "/config"
    }
  ]
}
    }
  }
}
