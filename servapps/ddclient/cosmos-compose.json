{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Ddclient",
          "description": "Web UI",
          "useHost": true,
          "target": "http://ddclient:80",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "ddclient": {
  "image": "linuxserver/ddclient:4.0.0@sha256:61de8a998f00bcf468a361f0df6007fb6ee8b2c6e89ed1c431145a98caeb7755",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID",
    "TZ": "$TZ"
  },
  "ports": [
    {
      "target": 80,
      "published": 80,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/ddclient/config",
      "target": "/config"
    }
  ]
}
    }
  }
}
