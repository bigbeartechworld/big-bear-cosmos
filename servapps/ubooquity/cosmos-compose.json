{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Ubooquity",
          "description": "Web UI",
          "useHost": true,
          "target": "http://ubooquity:2202",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "ubooquity": {
  "image": "linuxserver/ubooquity:3.1.0@sha256:e484ecb4aa66fd0bde885850f48c8818ee7c7cd9cdb8cd3b279a98b0fb6ec7e0",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID",
    "TZ": "$TZ",
    "MAXMEM": ""
  },
  "ports": [
    {
      "target": 2202,
      "published": 2202,
      "protocol": "tcp"
    },
    {
      "target": 2203,
      "published": 2203,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/ubooquity/config",
      "target": "/config"
    },
    {
      "type": "bind",
      "source": "/DATA/AppData/ubooquity/books",
      "target": "/books"
    },
    {
      "type": "bind",
      "source": "/DATA/AppData/ubooquity/comics",
      "target": "/comics"
    },
    {
      "type": "bind",
      "source": "/DATA/AppData/ubooquity/files",
      "target": "/files"
    }
  ]
}
    }
  }
}
