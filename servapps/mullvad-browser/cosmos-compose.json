{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Mullvad-browser",
          "description": "Web UI",
          "useHost": true,
          "target": "http://mullvad-browser:3000",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "mullvad-browser": {
  "image": "linuxserver/mullvad-browser:15.0.20251116@sha256:2bb0a028813463e3e7d2dbdbfb5727d7928fb7e8a17e206435ba27e61836d586",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID",
    "TZ": "$TZ",
    "LOCAL_NET": ""
  },
  "ports": [
    {
      "target": 3000,
      "published": 3000,
      "protocol": "tcp"
    },
    {
      "target": 3001,
      "published": 3001,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/mullvad-browser/config",
      "target": "/config"
    },
    {
      "type": "bind",
      "source": "/DATA/Downloads",
      "target": "/config/Downloads"
    }
  ],
  "cap_add": [
    "NET_ADMIN"
  ],
  "shm_size": "1gb"
}
    }
  }
}
