{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Homedex",
          "description": "Web UI",
          "useHost": true,
          "target": "http://homedex:7377",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "homedex": {
  "image": "ghcr.io/harshshah0203/homedex:0.2.5@sha256:c896084c063a358ed19932587d98f9a54d5520e5b2f9e1672ade279f8f0dcea0",
  "container_name": "homedex",
  "restart": "unless-stopped",
  "depends_on": [
    "docker-socket-proxy"
  ],
  "ports": [
    "7377:7377"
  ],
  "environment": {
    "HOMEDEX_DATA_DIR": "/data",
    "HOMEDEX_LISTEN": ":7377",
    "HOMEDEX_ADMIN_PASSWORD": "CHANGE_ME"
  },
  "volumes": [
    "big-bear-homedex_data:/data"
  ],
  "read_only": true,
  "tmpfs": [
    "/tmp"
  ],
  "cap_drop": [
    "ALL"
  ],
  "security_opt": [
    "no-new-privileges:true"
  ],
  "networks": [
    "app",
    "discovery"
  ]
}
    }
  }
}
