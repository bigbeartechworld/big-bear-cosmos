{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Mstream",
          "description": "Web UI",
          "useHost": true,
          "target": "http://mstream:3000",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "mstream": {
  "image": "linuxserver/mstream:6.30.0@sha256:896225514e635e6c8084ff6715f3a35f1c74b17d70cb5abbee00c47ece477ccb",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID",
    "TZ": "$TZ"
  },
  "ports": [
    {
      "target": 3000,
      "published": 3000,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/mstream/config",
      "target": "/config"
    },
    {
      "type": "bind",
      "source": "/DATA/AppData/mstream/music",
      "target": "/music"
    }
  ]
}
    }
  }
}
