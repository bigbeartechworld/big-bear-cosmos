{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Yq",
          "description": "Web UI",
          "useHost": true,
          "target": "http://yq:80",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "yq": {
  "image": "linuxserver/yq:4.4.5@sha256:ce29775b17f0c6c3cb180d4b9fa4b6fd20860c1f77d3684f9e8998628d0e4398",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID",
    "TZ": "$TZ"
  },
  "ports": [
    {
      "target": 80,
      "published": 80,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/yq/config",
      "target": "/config"
    }
  ]
}
    }
  }
}
