{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Webstation",
          "description": "Web UI",
          "useHost": true,
          "target": "http://webstation:3000",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "webstation": {
  "image": "linuxserver/webstation:0.14.2-romm@sha256:13d7c0fb09ff936e7f22120368d711e19012f869ba33fd73ceda65f13db44715",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID",
    "TZ": "$TZ"
  },
  "ports": [
    {
      "target": 3000,
      "published": 3000,
      "protocol": "tcp"
    },
    {
      "target": 3001,
      "published": 3001,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/webstation/config",
      "target": "/config"
    }
  ]
}
    }
  }
}
