{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Retroarch",
          "description": "Web UI",
          "useHost": true,
          "target": "http://retroarch:3000",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "retroarch": {
  "image": "linuxserver/retroarch:1.22.2@sha256:a21cb9131f7fd25af0ee42e8efc1a468a1c57edbe65a32db530c082c59e1d82c",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID",
    "TZ": "$TZ"
  },
  "ports": [
    {
      "target": 3000,
      "published": 3000,
      "protocol": "tcp"
    },
    {
      "target": 3001,
      "published": 3001,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/retroarch/config",
      "target": "/config"
    }
  ]
}
    }
  }
}
