{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Joomla",
          "description": "Web UI",
          "useHost": true,
          "target": "http://joomla:48105",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "joomla": {
  "image": "joomla:6.1.3-apache",
  "environment": {
    "JOOMLA_DB_HOST": "joomladb",
    "JOOMLA_DB_PASSWORD": "15311349-803b-40a2-9153-5b13f8d4022e"
  },
  "depends_on": [
    "joomladb"
  ],
  "ports": [
    {
      "target": 80,
      "published": 48105,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/$AppID/www",
      "target": "/var/www/html"
    }
  ]
}
    }
  }
}
