{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Freshrss",
          "description": "Web UI",
          "useHost": true,
          "target": "http://freshrss:80",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "freshrss": {
  "image": "linuxserver/freshrss:1.30.0@sha256:50f295fe361b2ef467a65232ab488ef161f8a0d6815d28b918c29fcb4a9c9690",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID",
    "TZ": "$TZ"
  },
  "ports": [
    {
      "target": 80,
      "published": 80,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/freshrss/config",
      "target": "/config"
    }
  ]
}
    }
  }
}
