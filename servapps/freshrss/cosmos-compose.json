{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Freshrss",
          "description": "Web UI",
          "useHost": true,
          "target": "http://freshrss:80",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "freshrss": {
  "image": "linuxserver/freshrss:1.30.2@sha256:f6418c990d37533223fa3fa3ce048edae021a8fd3aac6c46296a03c4c3249bf4",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID",
    "TZ": "$TZ"
  },
  "ports": [
    {
      "target": 80,
      "published": 80,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/freshrss/config",
      "target": "/config"
    }
  ]
}
    }
  }
}
