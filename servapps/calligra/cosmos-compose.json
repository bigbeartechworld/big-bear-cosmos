{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Calligra",
          "description": "Web UI",
          "useHost": true,
          "target": "http://calligra:3000",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "calligra": {
  "image": "linuxserver/calligra:3.2.1@sha256:7667e2f4b9d1ada53c510e05db59ab2233ac4b976476eadbdd4fb58ab19f245c",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID",
    "TZ": "$TZ"
  },
  "ports": [
    {
      "target": 3000,
      "published": 3000,
      "protocol": "tcp"
    },
    {
      "target": 3001,
      "published": 3001,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/calligra/config",
      "target": "/config"
    }
  ]
}
    }
  }
}
