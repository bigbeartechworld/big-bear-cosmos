{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Nano",
          "description": "Web UI",
          "useHost": true,
          "target": "http://nano:8075",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "nano": {
  "image": "linuxserver/nano:21.2.20220522@sha256:abba1dc5b14d99b1996a52b51d51f9247deea6f2c540d030c02060ea46491843",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID",
    "TZ": "$TZ",
    "PEER_HOST": "",
    "LIVE_GENESIS_PUB": "",
    "LIVE_GENESIS_ACCOUNT": "",
    "LIVE_GENESIS_WORK": "",
    "LIVE_GENESIS_SIG": "",
    "CLI_OPTIONS": "",
    "LMDB_BOOTSTRAP_URL": ""
  },
  "ports": [
    {
      "target": 8075,
      "published": 8075,
      "protocol": "tcp"
    },
    {
      "target": 7076,
      "published": 3000,
      "protocol": "tcp"
    },
    {
      "target": 7077,
      "published": 3001,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/nano/config",
      "target": "/config"
    }
  ]
}
    }
  }
}
