{
  "cosmos-installer": {
    "routes": [
        {
          "name": "FileBrowser Quantum v2",
          "description": "Web UI",
          "useHost": true,
          "target": "http://filebrowser-quantum-v2:8701",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "filebrowser-quantum-v2": {
  "container_name": "big-bear-filebrowser-quantum-v2",
  "image": "gtstef/filebrowser:2.0.1-stable@sha256:2e3936caf7b12908f7d3ebb68ddfcea075cda5f732e4bd95beae6cfa529cbec7",
  "restart": "unless-stopped",
  "environment": [
    "TZ=UTC",
    "FILEBROWSER_DATABASE_PATH=/home/filebrowser/data/database.sqlite"
  ],
  "volumes": [
    "big-bear-filebrowser-quantum-v2_data:/home/filebrowser/data",
    "big-bear-filebrowser-quantum-v2_srv:/srv"
  ],
  "ports": [
    "8701:80"
  ],
  "networks": [
    "big-bear-filebrowser-quantum-v2-network"
  ]
}
    }
  }
}
