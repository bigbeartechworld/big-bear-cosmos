{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Claude Code Container",
          "description": "Web UI",
          "useHost": true,
          "target": "http://claude-code:8080",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "claude-code": {
  "image": "caddy:2.11.7@sha256:685ae3d7c34d9b5f8caeddc5d14051db7bbd88ff1f5a2fa0c16bd8ca328fb7af",
  "container_name": "claude-code-caddy",
  "restart": "unless-stopped",
  "depends_on": [
    "claude"
  ],
  "ports": [
    "20040:8080"
  ],
  "networks": {
    "default": {
      "aliases": [
        "claude-code"
      ]
    }
  },
  "configs": [
    {
      "source": "caddyfile",
      "target": "/etc/caddy/Caddyfile"
    }
  ]
}
    }
  }
}
