{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Msedge",
          "description": "Web UI",
          "useHost": true,
          "target": "http://msedge:3000",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "msedge": {
  "image": "linuxserver/msedge:153.0.4234@sha256:e581a986c663d99e9088623d6b1cc677d992cb544b2057083e5e8a746d06c535",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID",
    "TZ": "$TZ",
    "EDGE_CLI": ""
  },
  "ports": [
    {
      "target": 3000,
      "published": 3000,
      "protocol": "tcp"
    },
    {
      "target": 3001,
      "published": 3001,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/msedge/config",
      "target": "/config"
    }
  ]
}
    }
  }
}
