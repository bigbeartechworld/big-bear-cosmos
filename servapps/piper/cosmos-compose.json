{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Piper",
          "description": "Web UI",
          "useHost": true,
          "target": "http://piper:10200",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "piper": {
  "image": "linuxserver/piper:2.5.2@sha256:46024a87839b5c3565bfe020a3a63f69d6fd715f8d20e28445792a3780b1aef4",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID",
    "TZ": "$TZ",
    "PIPER_VOICE": "",
    "LOCAL_ONLY": "",
    "PIPER_LENGTH": "",
    "PIPER_NOISE": "",
    "PIPER_NOISEW": "",
    "PIPER_SPEAKER": "",
    "NO_STREAMING": ""
  },
  "ports": [
    {
      "target": 10200,
      "published": 10200,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/piper/config",
      "target": "/config"
    }
  ]
}
    }
  }
}
