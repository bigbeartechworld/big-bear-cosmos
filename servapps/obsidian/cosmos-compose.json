{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Obsidian",
          "description": "Web UI",
          "useHost": true,
          "target": "http://obsidian:3000",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "obsidian": {
  "container_name": "big-bear-obsidian",
  "image": "linuxserver/obsidian:1.13.7@sha256:0ae1b2ffe772a0b4b2107f24e3462d22fa6067706d5b2f8a7cde964f855db863",
  "restart": "unless-stopped",
  "environment": [
    "PUID=1000",
    "PGID=1000",
    "TZ=Etc/UTC"
  ],
  "volumes": [
    "big-bear-obsidian_config:/config"
  ],
  "ports": [
    "3000:3000",
    "3001:3001"
  ]
}
    }
  }
}
