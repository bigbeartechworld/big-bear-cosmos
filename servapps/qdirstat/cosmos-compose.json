{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Qdirstat",
          "description": "Web UI",
          "useHost": true,
          "target": "http://qdirstat:3000",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "qdirstat": {
  "image": "linuxserver/qdirstat:2.0.20260913@sha256:3b3999ef8f0f3501cd35d373f0868e564937c739d1a79fbe545c6d68692bb727",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID",
    "TZ": "$TZ"
  },
  "ports": [
    {
      "target": 3000,
      "published": 3000,
      "protocol": "tcp"
    },
    {
      "target": 3001,
      "published": 3001,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/qdirstat/config",
      "target": "/config"
    },
    {
      "type": "bind",
      "source": "/DATA/AppData/qdirstat/data",
      "target": "/data"
    }
  ]
}
    }
  }
}
