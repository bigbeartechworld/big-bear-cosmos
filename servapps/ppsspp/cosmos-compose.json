{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Ppsspp",
          "description": "Web UI",
          "useHost": true,
          "target": "http://ppsspp:3000",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "ppsspp": {
  "image": "linuxserver/ppsspp:1.20.4@sha256:c2af8aae650c6da76aa25a4833c0108c6e689d7540ac34de3d3dc1678fb0b818",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID",
    "TZ": "$TZ"
  },
  "ports": [
    {
      "target": 3000,
      "published": 3000,
      "protocol": "tcp"
    },
    {
      "target": 3001,
      "published": 3001,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/ppsspp/config",
      "target": "/config"
    }
  ]
}
    }
  }
}
