{
  "cosmos-installer": {
    "routes": [
        {
          "name": "cairn",
          "description": "Web UI",
          "useHost": true,
          "target": "http://cairn:8080",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "cairn": {
  "image": "morgankryze/cairn:1.25.1@sha256:e1b159419bc66dd950ce99e665db2bd3502c210c13542ae4f05dc9ba6e218007",
  "container_name": "cairn",
  "ports": [
    "8080:8080"
  ],
  "volumes": [
    "big-bear-cairn_config:/config:ro"
  ],
  "read_only": true,
  "cap_drop": [
    "ALL"
  ],
  "security_opt": [
    "no-new-privileges:true"
  ],
  "healthcheck": {
    "test": [
      "CMD",
      "/cairn",
      "-healthcheck"
    ],
    "interval": "30s",
    "start_period": "5s"
  },
  "restart": "unless-stopped",
  "networks": [
    "cairn-network"
  ]
}
    }
  }
}
