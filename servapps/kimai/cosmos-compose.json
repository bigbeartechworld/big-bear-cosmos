{
  "cosmos-installer": {
    "routes": [
        {
          "name": "Kimai",
          "description": "Web UI",
          "useHost": true,
          "target": "http://kimai:80",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "BlockAPIAbuse": true
        }
      ],
    "services": {
      "kimai": {
  "image": "linuxserver/kimai:2.70.2@sha256:564810851b688cb84dec04bbc047ce971bc2fedb84422dd50a8b617ebb838893",
  "restart": "unless-stopped",
  "environment": {
    "PUID": "$PUID",
    "PGID": "$PGID",
    "TZ": "$TZ",
    "APP_SECRET": "",
    "DATABASE_URL": "",
    "TRUSTED_HOSTS": "",
    "TRUSTED_PROXIES": ""
  },
  "ports": [
    {
      "target": 80,
      "published": 80,
      "protocol": "tcp"
    },
    {
      "target": 443,
      "published": 443,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "type": "bind",
      "source": "/DATA/AppData/kimai/config",
      "target": "/config"
    }
  ]
}
    }
  }
}
